# Deployer / attestor wallet private key (fund with testnet zkLTC from https://liteforge.hub.caldera.xyz)
PRIVATE_KEY=

# Filled in after deploy
ATTESTATION_ADDRESS=

# REAL DATA: a Litecoin address whose on-chain balance is the reserve, read live
# via litecoinspace.org. On mainnet, point this at the Grail bridge address; on
# testnet use any real, public address as a transparent reference reserve.
LITECOIN_BRIDGE_ADDRESS=MQd1fJwqBJvwLuyhr17PhEFx1swiqDbPQS

# zkLTC supply is read live from the LiteForge Blockscout ethsupply endpoint — no
# config needed. (LTC_LOCKED_OVERRIDE / ZKLTC_SUPPLY_OVERRIDE exist only as a
# last-resort fallback for offline dev and are intentionally left unset.)
